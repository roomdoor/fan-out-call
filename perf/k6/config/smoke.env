# 파이프라인 점검용. 측정값을 쓰려는 설정이 아니다.
#
# apply 직후 이걸 먼저 돌린다. 부트스트랩, SSM 권한, 게이트웨이 재기동,
# DB 초기화, k6 실행, 드레인, 집계, manifest 기록까지 한 바퀴가 도는지 본다.
# 여기서 걸리는 것을 몇 시간짜리 측정 중간에 발견하면 그 시간을 날린다.
#
#   ./bench.sh config/smoke.env && node parse.mjs results/smoke

# 모드마다 다른 코드를 탄다 — coroutine은 awaitSingle, webclient는 Reactor
# 체인, async-threadpool은 @Async 풀. 하나만 보면 나머지 경로가 뚫리는지
# 모른 채 본 측정에 들어가게 된다.
MODES="coroutine async-threadpool webclient"

# 한 점만. 천장을 보려는 게 아니라 경로가 뚫리는지만 본다.
RPMS="30"
REPEATS=1
DURATION=1m

# 부하가 낮아 e2e가 이론 하한(31초) 근처다. 길게 잡을 이유가 없다.
MAX_WAIT_MS=90000

# async-threadpool 이 30 RPM 을 받으려면 풀이 270은 돼야 한다.
# 요청 1건이 9 스레드분(48x10s + 2x30s)을 쓰기 때문이다. 기본값은
# core 50 / queue 1000 이라 큐가 차기 전에는 50개로 도는 셈이고,
# 지속 천장이 50/9 = 약 5.5 RPM 이다. 그대로 두면 멀쩡한 서버에서도
# 거부가 찍혀, 스모크가 걸러내려던 가짜 경보를 스스로 만든다.
#
# 여기 풀 값은 측정 대상이 아니라 배경 조건이다. 풀을 재는 건 pool 설정들이다.
POOL=512
QUEUE=200

JAVA_OPTS="-Dkotlinx.coroutines.io.parallelism=512"
EXTRA_ARGS="--server.tomcat.threads.max=200 --app.web-client-fan-out.max-connections=8000"
