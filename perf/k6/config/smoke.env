# 파이프라인 점검용. 측정값을 쓰려는 설정이 아니다.
# apply 직후 이걸 먼저 돌려서 SSM 권한, 재기동, DB 초기화, 드레인, 집계까지
# 한 바퀴가 도는지 본다.
#
#   ./bench.sh config/smoke.env && node parse.mjs results/smoke

# 모드마다 다른 코드를 탄다. 하나만 보면 나머지 경로가 뚫리는지 모른다.
MODES="coroutine async-threadpool webclient"

RPMS="30"
REPEATS=1
DURATION=1m
MAX_WAIT_MS=90000

# 30 RPM 에 필요한 풀은 270이다(요청 1건이 9 스레드분). 기본값은 core 50 /
# queue 1000 이라 큐가 차기 전에는 50개로 돌아 약 5.5 RPM 에서 막히고,
# 멀쩡한 서버에서도 거부가 찍힌다. 여기 풀 값은 배경 조건이지 측정 대상이 아니다.
POOL=512
QUEUE=200

JAVA_OPTS="-Dkotlinx.coroutines.io.parallelism=512"
EXTRA_ARGS="--server.tomcat.threads.max=200 --app.web-client-fan-out.max-connections=8000"
