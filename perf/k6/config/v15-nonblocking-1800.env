# 동시성 모델 비교 3단계 — 논블로킹 두 모드를 1800 RPM 으로.
#
#   ./bench.sh config/v15-nonblocking-1800.env
#   node parse.mjs results/v15-nonblocking-1800
#
# 480/960/1200 에서 두 모드 모두 흠집이 없었다. COMPLETED 가 자릿수까지
# 같고 e2e p95 는 8ms 차이 - 이 부하에서는 구현 차이가 안 드러난다.
# 한 단 더 올려 천장이 보이는지 본다.

MODES="coroutine webclient"

RPMS="1800"

REPEATS=1
DURATION=4m
MAX_WAIT_MS=180000

JAVA_OPTS="-Dkotlinx.coroutines.io.parallelism=512"
EXTRA_ARGS="--server.tomcat.threads.max=200 --app.web-client-fan-out.max-connections=20000"

# 1800 에서 걸릴 만한 것들. 막히면 어느 쪽인지 지표로 구분된다.
#
#   커넥션   1800 x 9 = 16,200 < 20,000       여유 있음
#   게이트웨이 CPU  1200 에서 31% 였으니 약 46%  여유 있음
#   C 메모리  preAllocatedVUs = 3,600 x 3MB = 약 11GB / 16GB   ← 제일 빠듯
#   mock     초당 1,500 콜                     미지
#
# "k6가 버린 iteration" 경고 -> C 한계. 그 회차는 게이트웨이 수치가 아니다.
# "예외 은행콜" -> mock 또는 커넥션 문제.
# 둘 다 0 인데 거부가 나오면 그게 진짜 게이트웨이 천장이다.
