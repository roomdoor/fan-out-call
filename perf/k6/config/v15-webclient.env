# 동시성 모델 비교 2단계 — webclient.
#
#   ./bench.sh config/v15-webclient.env
#   node parse.mjs results/v15-webclient
#
# v15-coroutine.env 와 RPM·스레드·커넥션을 전부 같게 둔다. 조건이 같아야
# 두 논블로킹 모드의 차이가 드러난다. coroutine 은 1200 까지 흠집이 없었다
# (거부 0, e2e p95 31.4초 고정, 게이트웨이 CPU 31%).
#
# 같은 설정에서 webclient 가 막히면 그건 구현 차이다 - coroutine 은
# awaitSingle 로 suspend 하고, webclient 는 Reactor 체인을 그대로 흘린다.

MODE=webclient

RPMS="480 960 1200"

REPEATS=1
DURATION=4m
MAX_WAIT_MS=180000

JAVA_OPTS="-Dkotlinx.coroutines.io.parallelism=512"

# 커넥션 풀은 네 모드가 공유한다. 20000 이면 20000/9 = 2,222 RPM 까지
# 여유가 있어 1200 에서는 제약이 아니다.
EXTRA_ARGS="--server.tomcat.threads.max=200 --app.web-client-fan-out.max-connections=20000"
