# v15 기준선 — AWS 3호스트에서 잡는 새 기준선.
#
# v1~v14는 게이트웨이·mock·MySQL·k6가 한 macOS 기계에 있었고,
# macOS의 kern.num_taskthreads=2048이 async-threadpool 천장을 만들었다.
# 인프라와 하네스가 동시에 바뀌므로 기존 세대와 직접 비교하지 않는다.

MODE=coroutine
RPMS="100 200 400 600"
REPEATS=3
DURATION=4m

# 이론 하한이 31초다. 600 RPM 부근에서 e2e가 늘어나므로 넉넉히 준다.
MAX_WAIT_MS=180000

# coroutine 모드는 async-threadpool의 pool/queue를 쓰지 않는다.
POOLS=default

# run당 IO 워커 하나가 join()에 묶이는 구조는 coroutine 모드에도 남아 있다.
JAVA_OPTS="-Dkotlinx.coroutines.io.parallelism=512"

EXTRA_ARGS="--server.tomcat.threads.max=200 --app.web-client-fan-out.max-connections=8000"
