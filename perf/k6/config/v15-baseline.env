# v15 기준선 — AWS 3호스트. v1~v14와 직접 비교하지 않는다(다른 환경, 다른 집계).

MODE=coroutine
RPMS="100 200 400 600"
REPEATS=3
DURATION=4m

# 600 RPM 부근에서 e2e 가 늘어나므로 넉넉히 준다.
MAX_WAIT_MS=180000

# POOL 없음 = 애플리케이션 기본값. coroutine 은 그 풀을 안 읽는다.

# run 당 IO 워커 하나가 join() 에 묶인다.
JAVA_OPTS="-Dkotlinx.coroutines.io.parallelism=512"

EXTRA_ARGS="--server.tomcat.threads.max=200 --app.web-client-fan-out.max-connections=8000"
