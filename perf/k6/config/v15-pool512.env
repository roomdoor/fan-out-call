# pool 스윕 1단계. pool 하나만 돌린다.
#
# 4종을 한 번에 던지지 않는 이유: RPM ~ pool/9 는 계산값이지 잰 값이 아니다.
# 512에서 실제 천장이 40으로 나오면 공식이 틀린 것이고, 그걸 모른 채 4종을
# 다 돌리면 60회차를 통째로 버린다. 512 결과를 보고 다음 pool 의 RPM 범위를
# 정한다.
#
#   ./bench.sh config/v15-pool512.env
#   node parse.mjs results/v15-pool512
#   # 표에서 천장을 확인하고 config/v15-pool1024.env 를 만든다
#
# 512부터 하는 건 천장이 제일 낮아 제일 빨리 끝나서다.

MODE=async-threadpool

POOL=512
# 큐는 작게 고정한다 — 천장을 못 바꾸고, 초과 시 전원 timeout 대신
# 즉시 거부라 받은 건은 SLA 안에 끝난다.
QUEUE=200

# 계산상 천장이 512/9 = 약 57 RPM. 아래 한 점, 위 한 점이면 천장이 잡힌다.
RPMS="30 60"
REPEATS=3
DURATION=4m
MAX_WAIT_MS=180000

# 전 회차 동일하게 준다. 이게 v13에서 교란 변수였다.
JAVA_OPTS="-Dkotlinx.coroutines.io.parallelism=512"

EXTRA_ARGS="--server.tomcat.threads.max=200 --app.web-client-fan-out.max-connections=8000"
