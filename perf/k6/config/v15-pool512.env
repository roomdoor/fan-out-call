# pool 스윕 1단계. 이 결과를 보고 다음 pool 의 RPM 범위를 정한다.
#
#   ./bench.sh config/v15-pool512.env
#   node parse.mjs results/v15-pool512

MODE=async-threadpool

POOL=512
QUEUE=200

# 계산상 천장이 512/9 = 약 57 RPM. 아래 한 점, 위 한 점.
RPMS="30 60"

# 눈금 맞추는 판이라 한 번씩만. 보고서에 쓸 수치는 천장 위치가 좁혀진 뒤
# 그 지점만 REPEATS=3 으로 다시 잰다.
REPEATS=1

# 4분 밑으로 내리지 말 것. 60 RPM 이면 큐가 차는 데 약 77초라, 2분이면
# 거부 구간이 43초뿐이고 천장이 실제보다 높게 나온다.
DURATION=4m
MAX_WAIT_MS=180000

JAVA_OPTS="-Dkotlinx.coroutines.io.parallelism=512"
EXTRA_ARGS="--server.tomcat.threads.max=200 --app.web-client-fan-out.max-connections=8000"
