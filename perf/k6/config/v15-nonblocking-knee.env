# 논블로킹 천장 좁히기.
#
#   ./bench.sh config/v15-nonblocking-knee.env
#   node parse.mjs results/v15-nonblocking-knee
#
# 1200 까지 e2e p95 가 31.4초에 붙어 있다가 1800 에서 56.3/44.6초로
# 뛰었다. 그 사이에서 꺾이는 지점을 찾는다.
#
# 논블로킹은 거부가 없으므로 천장을 지연으로 정의한다 - e2e p95 가 31.4초에서
# 눈에 띄게 벗어나기 시작하는 RPM.
#
# 주의: 그 31.4초는 이론 하한이 아니라 폴링 눈금이다(저장소 루트 README 의
# "회차마다 게이트웨이를 재기동한다" 절). 물리 하한은 30초고, 이 스윕이
# 찾는 건 "지연이 늘기 시작하는 지점" 이 아니라 "다음 눈금으로 넘어가기
# 시작하는 지점" 이다.

MODES="coroutine webclient"

RPMS="1400 1600"

REPEATS=1
DURATION=4m
MAX_WAIT_MS=180000

JAVA_OPTS="-Dkotlinx.coroutines.io.parallelism=512"
EXTRA_ARGS="--server.tomcat.threads.max=200 --app.web-client-fan-out.max-connections=20000"
