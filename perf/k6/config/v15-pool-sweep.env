# v15 pool 스윕 — RPM ~ pool / 9 공식을 통제된 조건에서 검증한다.
#
# v13에서 이 공식을 확인한 점은 pool 1700 하나뿐이었다. pool 512/1024 회차는
# io.parallelism이 기본값 64라 Dispatchers.IO 교착에 먼저 걸렸고, 그래서
# 공식의 증거가 되지 못했다. 여기서는 io.parallelism을 전 회차 고정한다.
#
# macOS의 스레드 상한(2048) 때문에 로컬에서는 pool 1700이 끝이었다.
# Linux에는 그 벽이 없으므로 4096까지 올려 기울기를 그린다.

MODE=async-threadpool

# pool:queue. queue는 작게 고정한다 — 천장을 못 바꾸고,
# 초과 시 전원 timeout 대신 즉시 거부라 받은 건은 SLA 내에 끝난다.
POOLS="512:200 1024:200 2048:200 4096:200"

# 이론 천장은 pool/9. 각 pool의 천장 근처를 지나도록 잡는다.
RPMS="60 120 240 460"
REPEATS=3
DURATION=4m
MAX_WAIT_MS=180000

# 전 회차 동일하게 준다. 이게 v13에서 교란 변수였다.
JAVA_OPTS="-Dkotlinx.coroutines.io.parallelism=512"

EXTRA_ARGS="--server.tomcat.threads.max=200 --app.web-client-fan-out.max-connections=8000"
