# 1800 RPM 의 지연 증가가 IO 디스패처 때문인지 가린다.
#
#   ./bench.sh config/v15-nonblocking-1800-io1024.env
#   node parse.mjs results/v15-nonblocking-1800-io1024
#
# v15-nonblocking-1800-conn40k 와 io.parallelism 하나만 다르다(512 -> 1024).
#
# 지금까지 배제된 것 - 전부 1800 RPM 구간 실측이다.
#   커넥션 풀   20k -> 40k 로 올려도 지연 동일(1% 안쪽)
#   C  (k6)     CPU 최대 5.8%
#   A  (게이트웨이) CPU 최대 38.4%
#   B  (mock)   CPU 최대 20.1%
#
# 남은 유력 후보가 IO 워커다. 두 모드가 쓰는 양이 다르다 -
#   coroutine  은행 호출(async(Dispatchers.IO)) + 결과 저장 둘 다
#   webclient  결과 저장만(mono(Dispatchers.IO), run 당 50회)
# 1800 에서 coroutine 56초 / webclient 44초로 갈린 것과 방향이 맞는다.
#
#   둘 다 31초대로 복귀      -> IO 워커가 병목. 확정
#   coroutine 만 크게 개선   -> 경합량 차이 해석이 맞다
#   둘 다 그대로            -> IO 워커도 아니다. 다음 후보는 DB 저장
#                              (1800 RPM 이면 초당 1,500 건이 MySQL 로 간다)

MODES="coroutine webclient"

RPMS="1800"

REPEATS=1
DURATION=4m
MAX_WAIT_MS=180000

JAVA_OPTS="-Dkotlinx.coroutines.io.parallelism=1024"
EXTRA_ARGS="--server.tomcat.threads.max=200 --app.web-client-fan-out.max-connections=40000"
