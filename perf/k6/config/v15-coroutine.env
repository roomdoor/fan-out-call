# 동시성 모델 비교 1단계 — coroutine.
#
#   ./bench.sh config/v15-coroutine.env
#   node parse.mjs results/v15-coroutine
#
# async-threadpool 스윕과 나란히 놓고 "같은 정도의 자원에서 누가 더 내는가"
# 를 본다. 예산이 정확히 같지는 않다 - async 쪽은 @Async 풀에 더해
# io.parallelism 512 도 함께 받는다.
#
# 실측 구간(results/v15-pool512, v15-pool4096):
#   pool  512   30 RPM 깨끗 /  60 RPM 거부 317, 처리율 43.8/분
#   pool 4096  240 RPM 깨끗 / 480 RPM 거부 3,409, 처리율 338.8/분
#
# 천장 자체(57, 455)는 pool/9 계산값이고 재지 않았다. 잰 것은 위 구간이다.
#
# io.parallelism 은 pool 스윕 네 판과 이 판이 모두 512 다(1024 로 올린 판은
# v15-nonblocking-1800-io1024 하나뿐이다).
#
# async-threadpool 모드도 async(Dispatchers.IO) 를 거치지만, 은행 응답을
# 기다리는 동안에는 IO 워커를 붙잡지 않는다 - await() 가 suspend 다
# (kotlinx.coroutines.future.await). 실제 블로킹은 @Async 스레드 안의
# runBlocking 이다. pool 스윕에서 io.parallelism 을 512 로 둔 채 풀만 8배
# 올렸을 때 천장이 그대로 8배 따라 올라간 것이 그 증거다.
#
# 다만 IO 워커를 아예 안 쓰는 건 아니다. 결과 저장(onEachResult -> 블로킹
# JPA)이 async(Dispatchers.IO) 블록 안에서 돌기 때문에, 저장하는 동안에는
# IO 워커가 묶인다.

MODE=coroutine

# POOL 은 안 준다. coroutine 은 async-threadpool 의 풀을 읽지 않는다.

# 천장이 어디인지 모르는 상태에서 잡은 범위다. async-threadpool 이 막힌
# 480 을 아래 점으로 두고 두 배 위까지 훑는다.
#
# (이 파일을 쓸 때는 "512 워커 / 31초 = 약 990 RPM" 을 예상 천장으로 봤는데
#  틀렸다. awaitAll 은 suspend 라 워커를 붙잡지 않는다. 실제로는 1200 에서도
#  31.4초 그대로였고, 꺾임은 1400~1600 사이다 - v15-nonblocking-knee 참조.
#  그 31.4초는 이론 하한이 아니라 폴링 눈금이다 - 루트 README 참조.)
RPMS="480 960 1200"

REPEATS=1
DURATION=4m
MAX_WAIT_MS=180000

JAVA_OPTS="-Dkotlinx.coroutines.io.parallelism=512"

# 커넥션 풀은 네 모드가 공유한다(WebClientConfig 의 sharedBankWebClient).
# 20000 으로 올려 두되, 이 값이 제약이 될 일은 사실상 없다 - maxConnections
# 는 원격 주소마다 적용되고 mock 이 10 샤드라 풀이 10개 생긴다.
#
# 샤드당 수요는 균등하지 않다. 샤딩이 (bankNumber-1) % 10 이라 30초짜리
# 느린 은행 2개가 한두 샤드에 몰린다. 가장 무거운 샤드가 4x10 + 30 = 70
# 커넥션초를 쓰므로 RPM x 1.17 이고, 두 은행이 같은 샤드면 RPM x 1.5 다.
# 20000 이면 약 13,000~17,000 RPM 까지 여유가 있다.
#
# (이 파일을 쓸 때는 풀이 하나라고 보고 "8000/9 = 889 RPM 에서 막힌다" 고
#  적었는데 틀렸다. 실제로는 8000 이어도 5,000 RPM 대까지 간다.)
EXTRA_ARGS="--server.tomcat.threads.max=200 --app.web-client-fan-out.max-connections=20000"
