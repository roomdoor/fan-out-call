# 동시성 모델 비교 1단계 — coroutine.
#
#   ./bench.sh config/v15-coroutine.env
#   node parse.mjs results/v15-coroutine
#
# async-threadpool 스윕과 같은 스레드 예산(512)으로 돌린다. 그래야
# "같은 자원에서 누가 더 내는가" 가 비교된다.
#
#   async-threadpool @ pool 512      천장 57 RPM   (측정됨)
#   async-threadpool @ pool 4096     천장 455 RPM  (측정됨)
#   coroutine        @ io.parallelism 512  ← 이 판

MODE=coroutine

# POOL 은 안 준다. coroutine 은 async-threadpool 의 풀을 읽지 않는다.

# 예상 천장은 512 워커 / 31초 = 초당 16.5 = 약 990 RPM.
# 은행 호출 50개는 awaitSingle 로 suspend 해서 워커를 놓지만, run 을 감싼
# 바깥 코루틴이 awaitAll 로 31초 묶여 있다. 그게 run 당 워커 1개다.
RPMS="480 960 1200"

REPEATS=1
DURATION=4m
MAX_WAIT_MS=180000

JAVA_OPTS="-Dkotlinx.coroutines.io.parallelism=512"

# 커넥션 풀은 네 모드가 공유한다(WebClientConfig 의 sharedBankWebClient).
# 8000 이면 8000/9 = 889 RPM 에서 먼저 막혀, 스레드가 아니라 커넥션을 재게
# 된다. 1200 RPM 에 필요한 10,800 보다 넉넉히 열어 스레드만 제약으로 남긴다.
EXTRA_ARGS="--server.tomcat.threads.max=200 --app.web-client-fan-out.max-connections=20000"
