# 동시성 모델 비교 1단계 — coroutine.
#
#   ./bench.sh config/v15-coroutine.env
#   node parse.mjs results/v15-coroutine
#
# async-threadpool 스윕과 나란히 놓고 "같은 정도의 자원에서 누가 더 내는가"
# 를 본다. 정확히 같은 예산은 아니다 - 아래 주의 참고.
#
# 실측 구간(results/v15-pool512, v15-pool4096):
#   pool  512   30 RPM 깨끗 /  60 RPM 거부 317, 처리율 43.8/분
#   pool 4096  240 RPM 깨끗 / 480 RPM 거부 3,409, 처리율 338.8/분
#
# 천장 자체(57, 455)는 pool/9 계산값이고 재지 않았다. 잰 것은 위 구간이다.
#
# io.parallelism 은 전 판 512 로 고정이다. async-threadpool 모드도
# async(Dispatchers.IO) 를 거치지만 안에서 쓰는 await() 가 suspend 라
# (kotlinx.coroutines.future.await) IO 워커를 점유하지 않는다. pool 스윕에서
# io.parallelism 을 512 로 둔 채 풀만 8배 올렸을 때 천장이 그대로 8배
# 따라 올라간 것이 그 증거다. 점유되는 것은 @Async 풀뿐이다.

MODE=coroutine

# POOL 은 안 준다. coroutine 은 async-threadpool 의 풀을 읽지 않는다.

# 천장이 어디인지 모르는 상태에서 잡은 범위다. async-threadpool 이 막힌
# 480 을 아래 점으로 두고 두 배 위까지 훑는다.
#
# (이 파일을 쓸 때는 "512 워커 / 31초 = 약 990 RPM" 을 예상 천장으로 봤는데
#  틀렸다. awaitAll 은 suspend 라 워커를 붙잡지 않는다. 실제로는 1200 에서도
#  이론 하한 그대로였고, 꺾임은 1600~1800 사이다 - v15-nonblocking-knee 참조.)
RPMS="480 960 1200"

REPEATS=1
DURATION=4m
MAX_WAIT_MS=180000

JAVA_OPTS="-Dkotlinx.coroutines.io.parallelism=512"

# 커넥션 풀은 네 모드가 공유한다(WebClientConfig 의 sharedBankWebClient).
# 20000 으로 올려 두되, 이 값이 제약이 될 일은 사실상 없다 - maxConnections
# 는 원격 주소마다 적용되고 mock 이 10 샤드라 풀이 10개 생긴다. 샤드당
# 수요는 RPM x 0.9 다.
#
# (이 파일을 쓸 때는 풀이 하나라고 보고 "8000/9 = 889 RPM 에서 막힌다" 고
#  적었는데 10배 틀렸다. 실제로는 8000 이어도 약 8,900 RPM 까지 간다.)
EXTRA_ARGS="--server.tomcat.threads.max=200 --app.web-client-fan-out.max-connections=20000"
