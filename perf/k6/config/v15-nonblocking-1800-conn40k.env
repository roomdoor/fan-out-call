# 1800 RPM 의 지연 증가가 커넥션 풀 때문인지 가린다.
#
#   ./bench.sh config/v15-nonblocking-1800-conn40k.env
#   node parse.mjs results/v15-nonblocking-1800-conn40k
#
# v15-nonblocking-1800 과 커넥션 수 하나만 다르다. 나머지는 전부 같다.
#
#   1600 → e2e p95 32.0 / 31.6초 (커넥션 14,400 = 한도의 72%)
#   1800 → e2e p95 56.3 / 44.6초 (커넥션 16,200 = 한도의 81%)
#
# CPU 는 C 5.8%, 게이트웨이 38.4%(CloudWatch)로 둘 다 여유가 있었다. 버린 iteration 과
# 예외 은행콜도 0 이라 장비가 막은 게 아니다. 남은 유력 후보가 커넥션이다 -
# Netty 는 풀이 마르면 pendingAcquire 로 대기시키는데, 그 대기가 e2e 에
# 그대로 더해진다. 거부가 아니라 지연으로 나타나는 것과도 맞는다.
#
# 40,000 이면 1800 RPM 에 필요한 16,200 이 40% 다.
#   지연이 31초대로 돌아오면 -> 커넥션이 원인. 천장은 더 위.
#   그대로 56초면      -> 커넥션이 아니다. 모델이나 mock 쪽.

MODES="coroutine webclient"

RPMS="1800"

REPEATS=1
DURATION=4m
MAX_WAIT_MS=180000

JAVA_OPTS="-Dkotlinx.coroutines.io.parallelism=512"
EXTRA_ARGS="--server.tomcat.threads.max=200 --app.web-client-fan-out.max-connections=40000"
