# pool 스윕 3단계.
#
#   ./bench.sh config/v15-pool2048.env
#   node parse.mjs results/v15-pool2048

MODE=async-threadpool

POOL=2048
QUEUE=200

# 계산상 천장은 2048/9 = 약 228 RPM.
#
# 120 은 pool 1024 에서 은행콜 740건이 거부됐던 지점이다. 여기서 0이면
# 풀 크기만으로 결과가 갈린다는 세 번째 확인이 된다.
RPMS="120 240"

REPEATS=1
DURATION=4m
MAX_WAIT_MS=180000

JAVA_OPTS="-Dkotlinx.coroutines.io.parallelism=512"
EXTRA_ARGS="--server.tomcat.threads.max=200 --app.web-client-fan-out.max-connections=8000"
