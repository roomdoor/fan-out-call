# pool 스윕 4단계. 마지막.
#
#   ./bench.sh config/v15-pool4096.env
#   node parse.mjs results/v15-pool4096

MODE=async-threadpool

POOL=4096
QUEUE=200

# 계산상 천장은 4096/9 = 약 455 RPM.
#
# 240 은 pool 2048 에서 막혔던 지점이다. 460 은 천장 바로 위.
RPMS="240 460"

REPEATS=1
DURATION=4m
MAX_WAIT_MS=180000

# 여기서 처음 걸릴 만한 것들 — 앞 세 판에는 없던 조건이다.
#   * 게이트웨이에 플랫폼 스레드 4096개. 기본 스택 1MB 기준으로 가상 메모리가
#     크게 잡힌다. A 는 16GiB 라 돌 것으로 보지만 확인된 적은 없다.
#   * 460 RPM 이면 k6 maxVUs 가 4600 이다. C 가 도착률을 못 맞추면
#     parse.mjs 가 "k6가 버린 iteration" 경고를 찍는다. 그 회차는
#     게이트웨이 천장이 아니라 C 호스트 한계를 잰 것이다.
#   * mock 으로 초당 383 콜이 나간다(460 x 50 / 60).
JAVA_OPTS="-Dkotlinx.coroutines.io.parallelism=512"
EXTRA_ARGS="--server.tomcat.threads.max=200 --app.web-client-fan-out.max-connections=8000"
