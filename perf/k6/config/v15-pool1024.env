# pool 스윕 2단계. v15-pool512 결과를 보고 RPM 범위를 정했다.
#
#   ./bench.sh config/v15-pool1024.env
#   node parse.mjs results/v15-pool1024

MODE=async-threadpool

POOL=1024
QUEUE=200

# 계산상 천장은 1024/9 = 약 114 RPM.
#
# 60 은 pool 512 에서도 쟀던 지점이다. 거기서 은행콜 290건이 거부됐는데
# 여기서 0이면, 같은 부하에서 풀 크기만으로 결과가 갈린다는 직접 비교가 된다.
# 120 은 천장 바로 위라 거부가 나와야 한다.
RPMS="60 120"

REPEATS=1
DURATION=4m
MAX_WAIT_MS=180000

JAVA_OPTS="-Dkotlinx.coroutines.io.parallelism=512"
EXTRA_ARGS="--server.tomcat.threads.max=200 --app.web-client-fan-out.max-connections=8000"
